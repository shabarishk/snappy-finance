# Required. Generate a password and two independent secrets before deployment.
APP_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=

POSTGRES_DB=snappy_finance
POSTGRES_USER=snappy_finance
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
WEB_PORT=8080
API_PORT=127.0.0.1:8081
SYNC_INTERVAL=6h
DEMO_DATA=false
